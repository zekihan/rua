    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
